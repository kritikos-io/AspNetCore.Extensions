<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <PropertyGroup Label="Package">
    <Description>Wires RFC 9728 OAuth2 protected-resource metadata to the configured JWT bearer scheme's authority, so the published metadata follows the API's authentication configuration instead of a hard-coded list.</Description>
    <PackageTags>aspnetcore;minimal-api;authentication;oauth2;oidc;jwt;rfc9728;well-known</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AspNetCore.MinimalApiExtensions\AspNetCore.MinimalApiExtensions.csproj"/>
  </ItemGroup>

</Project>
