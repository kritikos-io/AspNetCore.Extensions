<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <SkipClsCompliant>true</SkipClsCompliant>
  </PropertyGroup>

  <PropertyGroup Label="Package">
    <Description>Gates Minimal API endpoints on Microsoft.FeatureManagement flags through an endpoint filter, and adds a session-backed feature-state manager.</Description>
    <PackageTags>aspnetcore;minimal-api;feature-management;feature-flags;endpoint-filter;session</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.FeatureManagement.AspNetCore" />
  </ItemGroup>

</Project>
