<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <PropertyGroup Label="Package">
    <Description>Delegating handler that attaches an OAuth2 client-credentials bearer token to outgoing requests, cached until shortly before expiry with concurrent refreshes coalesced into a single token request.</Description>
    <PackageTags>httpclient;delegating-handler;oauth2;client-credentials;openid-connect;bearer-token;authentication</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http"/>
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect"/>
  </ItemGroup>

</Project>
