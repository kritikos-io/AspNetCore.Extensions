<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <SkipClsCompliant>true</SkipClsCompliant>
  </PropertyGroup>

  <PropertyGroup Label="Package">
    <Description>Opinionated defaults for Asp.Versioning API versioning and the API explorer, with versioned Minimal API endpoint contracts and an RFC 9727 api-catalog source that advertises each version's OpenAPI document.</Description>
    <PackageTags>aspnetcore;minimal-api;api-versioning;asp-versioning;api-explorer;api-catalog;rfc9727</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AspNetCore.MinimalApiExtensions\AspNetCore.MinimalApiExtensions.csproj"/>
  </ItemGroup>

</Project>
