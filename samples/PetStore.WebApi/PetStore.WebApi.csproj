<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <NoWarn>$(NoWarn);CA1515</NoWarn>
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Microsoft.AspNetCore.Http.Validation.Generated</InterceptorsNamespaces>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AspNetCore.FeatureManagementOptionTests" />
    <InternalsVisibleTo Include="AspNetCore.MinimalApiExtensions.Tests" />
    <InternalsVisibleTo Include="AspNetCore.VersioningTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Asp.Versioning.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Scalar.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AspNetCore.FeatureManagementOptions\AspNetCore.FeatureManagementOptions.csproj" />
    <ProjectReference Include="..\..\src\AspNetCore.MinimalApiExtensions\AspNetCore.MinimalApiExtensions.csproj" />
    <ProjectReference Include="..\..\src\AspNetCore.MinimalApiExtensions.Authentication\AspNetCore.MinimalApiExtensions.Authentication.csproj" />
    <ProjectReference Include="..\..\src\AspNetCore.OpenApiExtensions\AspNetCore.OpenApiExtensions.csproj" />
    <ProjectReference Include="..\..\src\AspNetCore.OpenApiFeatureManagementOptions\AspNetCore.OpenApiFeatureManagementOptions.csproj" />
    <ProjectReference Include="..\..\src\AspNetCore.VersioningOptions\AspNetCore.VersioningOptions.csproj" />
    <ProjectReference Include="..\..\src\SemanticVersioning.DependencyInjection\SemanticVersioning.DependencyInjection.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageVersion Update="Microsoft.Extensions.ApiDescription.Server" Version="10.0.10" />
  </ItemGroup>

</Project>
